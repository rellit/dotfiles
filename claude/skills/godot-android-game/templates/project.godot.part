[application]

config/name="__NAME__"
config/description="__NAME__: <one line>"
config/version="1.0.0"
run/main_scene="res://scenes/game.tscn"
config/quit_on_go_back=false
config/icon="res://assets/icon/icon.png"
boot_splash/bg_color=Color(0.086, 0.098, 0.133, 1)
boot_splash/image="res://assets/splash/splash.png"
boot_splash/stretch_mode=1
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]

file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/orbitron.tres"

[internationalization]

locale/translations=PackedStringArray("res://locale/de.po")
locale/fallback="en"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.086, 0.098, 0.133, 1)
